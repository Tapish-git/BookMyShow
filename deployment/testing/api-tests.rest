# =============================================
# USER REGISTRATION & AUTHENTICATION
# =============================================

### Register New User
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "Test User API",
  "email": "apitest@bookmyshow.com",
  "phone": "9888888888",
  "password": "testpassword123"
}

### Login User
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{testEmail}}",
  "password": "{{testPassword}}"
}

### Login with Invalid Credentials
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "invalid@email.com",
  "password": "wrongpassword"
}

# =============================================
# BOOKING FLOW TESTS
# (Note: These require authentication session)
# =============================================

### Create Seat Reservation
POST {{baseUrl}}/reservations
Content-Type: application/json
# Session required

{
  "showId": 1,
  "seatIds": [1, 2],
  "userId": 1
}

### Get User Reservations
GET {{baseUrl}}/reservations/user/1
Accept: application/json
# Session required

### Create Booking
POST {{baseUrl}}/bookings
Content-Type: application/json
# Session required

{
  "showId": 1,
  "seatIds": [3, 4],
  "userId": 1,
  "totalAmount": 500.00
}

### Get User Bookings
GET {{baseUrl}}/users/1/bookings
Accept: application/json
# Session required

### Get Booking Details
GET {{baseUrl}}/bookings/1
Accept: application/json
# Session required

### Update Booking Status
PUT {{baseUrl}}/bookings/1/status
Content-Type: application/json
# Session required

{
  "status": "confirmed",
  "paymentStatus": "completed"
}

