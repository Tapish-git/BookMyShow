# BookMyShow API Integration Tests
# VS Code REST Client Extension Required
# Install: ms-vscode.vscode-restclient

# =============================================
# ENVIRONMENT VARIABLES
# =============================================
@baseUrl = http://localhost:3000/api
@frontendUrl = http://localhost:5173

# Test user credentials (from seed data)
@testEmail = test@bookmyshow.com
@testPassword = password123

# =============================================
# HEALTH CHECK
# =============================================

### Health Check
GET {{baseUrl}}/health
Accept: application/json

### Server Status
GET {{baseUrl}}/status
Accept: application/json

# =============================================
# MOVIES API TESTS
# =============================================

### Get All Movies
GET {{baseUrl}}/movies
Accept: application/json

### Get Movie by ID
GET {{baseUrl}}/movies/1
Accept: application/json

### Get Movie by Invalid ID
GET {{baseUrl}}/movies/999
Accept: application/json

### Get Movies with Query Parameters
GET {{baseUrl}}/movies?language=English&limit=5
Accept: application/json

### Search Movies by Title
GET {{baseUrl}}/movies?search=avengers
Accept: application/json

# =============================================
# THEATERS API TESTS
# =============================================

### Get All Theaters
GET {{baseUrl}}/theaters
Accept: application/json

### Get Theater by ID
GET {{baseUrl}}/theaters/1
Accept: application/json

### Get Theaters by City
GET {{baseUrl}}/theaters?city=Mumbai
Accept: application/json

### Get Theater with Invalid ID
GET {{baseUrl}}/theaters/999
