  "showId": 1,
  "seatIds": [1, 2],
  "userId": 2
}

### Booking Past Show
POST {{baseUrl}}/bookings
Content-Type: application/json

{
  "showId": 1,
  "seatIds": [5, 6],
  "userId": 1,
