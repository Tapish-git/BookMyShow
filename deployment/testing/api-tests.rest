  "showTime": "2020-01-01T10:00:00Z"
}

# =============================================
# INTEGRATION SCENARIOS
# =============================================

### Complete Booking Flow Test
# 1. Get available shows
GET {{baseUrl}}/shows?movieId=1&date=2024-12-13
Accept: application/json

### 2. Check available seats for selected show
GET {{baseUrl}}/shows/7/seats?available=true
Accept: application/json

### 3. Reserve seats (requires session)
POST {{baseUrl}}/reservations
Content-Type: application/json

{
  "showId": 7,
  "seatIds": [15, 16],
  "userId": 1
}

### 4. Create booking (requires session)
POST {{baseUrl}}/bookings
Content-Type: application/json

{
  "showId": 7,
  "seatIds": [15, 16],
  "userId": 1,
  "totalAmount": 540.00
}

### 5. Confirm payment (requires session)
PUT {{baseUrl}}/bookings/7/status
Content-Type: application/json

{
  "status": "confirmed",
  "paymentStatus": "completed"
}

